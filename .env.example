# Copy to .env and fill in real values. .env is gitignored — never commit it.

# --- LLM provider ---
# Default provider is OpenAI. Set LLM_PROVIDER=anthropic to use Claude instead.
LLM_PROVIDER=openai
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o

# Only needed if LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Neo4j (graph-RAG layer, not yet wired up) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
